{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "LestoIdentityService",
    "Audience": "LestoApiGateway"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "points-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/points/{**catch-all}"
        }
      },
      "settings-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "Match": {
          "Path": "/api/settings/{**catch-all}"
        }
      },
      "payments-webhook-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/webhook"
        }
      },
      "payments-return-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/return/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "order-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          },
          "destination2": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}
