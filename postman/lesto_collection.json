              "name": "Listar Utilizadores (Admin)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Admin consegue listar utilizadores (Status 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
